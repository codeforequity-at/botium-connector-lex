{
  "name": "botium-connector-lex",
  "version": "0.2.2",
  "description": "Botium Connector for Amazon Lex",
  "type": "module",
  "main": "dist/botium-connector-lex-cjs.cjs",
  "module": "dist/botium-connector-lex-es.js",
  "exports": {
    ".": {
      "import": "./dist/botium-connector-lex-es.js",
      "require": "./dist/botium-connector-lex-cjs.cjs",
      "default": "./dist/botium-connector-lex-cjs.cjs"
    }
  },
  "bin": {
    "botium-connector-lex-cli": "./bin/cli.js"
  },
  "scripts": {
    "build": "rollup -c",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "eslint": "eslint index.js bin/**/*.js src/**/*.js",
    "eslint-fix": "eslint --fix index.js bin/**/*.js src/**/*.js",
    "update-dependencies": "npm-check-updates -u --timeout 60000",
    "test": "echo Just placeholder, no tests here yet",
    "test-nightly": "mocha test/nightly/**/*spec.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeforequity-at/botium-connector-lex.git"
  },
  "author": "Botium GmbH",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/codeforequity-at/botium-core/issues"
  },
  "homepage": "https://www.botium.ai",
  "devDependencies": {
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "dotenv": "^16.0.3",
    "eslint": "^7.32.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-mocha": "^10.1.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-standard": "^4.1.0",
    "mocha": "^10.2.0",
    "npm-check-updates": "^11.8.5",
    "rollup": "^2.58.0",
    "rollup-plugin-json": "^4.0.0"
  },
  "dependencies": {
    "aws-sdk": "^2.1004.0",
    "debug": "^4.3.2",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.33",
    "mkdirp": "^1.0.4",
    "moment": "^2.29.1",
    "randomatic": "^3.1.1",
    "slug": "^5.1.0",
    "yargs": "^17.2.1"
  }
}
